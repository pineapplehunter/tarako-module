Subject: [PATCH] virt: tdx-guest: poll quote completion every 5 ms

The one-second completion polling interval hides the actual quote latency
when QGS responds in less than a second. Poll every 5 ms instead, using a
jiffies deadline to preserve the existing timeout in seconds independently
of the polling interval. Read the VMM-updated status with READ_ONCE().

--- a/drivers/virt/coco/tdx-guest/tdx-guest.c
+++ b/drivers/virt/coco/tdx-guest/tdx-guest.c
@@ -16,6 +16,7 @@
 #include <linux/set_memory.h>
 #include <linux/io.h>
 #include <linux/delay.h>
+#include <linux/jiffies.h>
 #include <linux/sockptr.h>
 #include <linux/tsm.h>
 #include <linux/tsm-mr.h>
@@ -251,18 +252,18 @@
  */
 static int wait_for_quote_completion(struct tdx_quote_buf *quote_buf, u32 timeout)
 {
-	int i = 0;
-
-	/*
-	 * Quote requests usually take a few seconds to complete, so waking up
-	 * once per second to recheck the status is fine for this use case.
-	 */
-	while (quote_buf->status == GET_QUOTE_IN_FLIGHT && i++ < timeout) {
-		if (msleep_interruptible(MSEC_PER_SEC))
+	unsigned long deadline = jiffies + msecs_to_jiffies(timeout * MSEC_PER_SEC);
+
+	/* Poll every 5 ms without shortening the overall timeout. */
+	while (READ_ONCE(quote_buf->status) == GET_QUOTE_IN_FLIGHT) {
+		if (time_after_eq(jiffies, deadline))
+			return -ETIMEDOUT;
+
+		if (msleep_interruptible(5))
 			return -EINTR;
 	}
 
-	return (i == timeout) ? -ETIMEDOUT : 0;
+	return 0;
 }
 
 static int tdx_report_new_locked(struct tsm_report *report, void *data)
