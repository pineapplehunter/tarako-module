 #include <linux/err.h>
 #include <linux/fs.h>
+#include <linux/mount.h>
+#include <linux/string.h>
+
+/* Built-in init runs before userspace mounts /sys. The open file pins the
+ * private mount for the lifetime of the extender. */
+struct file *ima_rtmr_open(const char *path)
+{
+    struct file_system_type *type;
+    struct vfsmount *mnt;
+    struct file *file;
+
+    if (strncmp(path, "/sys/", 5))
+        return ERR_PTR(-EINVAL);
+    type = get_fs_type("sysfs");
+    if (!type)
+        return ERR_PTR(-ENODEV);
+    mnt = kern_mount(type);
+    put_filesystem(type);
+    if (IS_ERR(mnt))
+        return ERR_CAST(mnt);
+    file = file_open_root_mnt(mnt, path + 5, O_RDWR, 0);
+    kern_unmount(mnt);
+    return file;
+}
 
