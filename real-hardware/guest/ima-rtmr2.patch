@@ -90,11 +90,73 @@ static int tdx_do_extend(u8 mr_ind, const u8 *data)
 	return 0;
 }
 
+#ifdef CONFIG_IMA_RTMR
+/* Private TDCALL operands: never share the userspace report buffer or hold
+ * mr_lock (which nests user copies) under IMA's measurement-list mutex.
+ * Retry only OPERAND_BUSY, for which no extend was committed.
+ */
+static u8 ima_operand[TDX_REPORTDATA_LEN] __aligned(64);
+static u8 ima_report[TDX_REPORT_LEN] __initdata __aligned(TDX_REPORT_LEN);
+static u8 ima_initial[SHA384_DIGEST_SIZE] __ro_after_init;
+
+static ssize_t initial_show(struct kobject *k, struct kobj_attribute *a, char *buf)
+{
+	return sysfs_emit(buf, "%*phN\n", (int)sizeof(ima_initial), ima_initial);
+}
+static struct kobj_attribute initial_attr = __ATTR_RO(initial);
+
+void __init tdx_ima_rtmr_init(int hash_algo)
+{
+	struct kobject *k;
+	int rc;
+
+	if (!boot_cpu_has(X86_FEATURE_TDX_GUEST))
+		return;
+	if (hash_algo != HASH_ALGO_SHA384)
+		panic("IMA RTMR2 requires ima_hash=sha384");
+	do {
+		rc = tdx_mcall_get_report0(ima_operand, ima_report);
+		if (rc == -EBUSY)
+			cond_resched();
+	} while (rc == -EBUSY);
+	if (rc)
+		panic("IMA RTMR2 baseline read failed: %d", rc);
+	memcpy(ima_initial, ima_report + TDREPORT_rtmr2, sizeof(ima_initial));
+	k = kobject_create_and_add("ima_rtmr2", kernel_kobj);
+	if (!k || sysfs_create_file(k, &initial_attr.attr))
+		panic("IMA RTMR2 baseline export failed");
+}
+
+void tdx_ima_rtmr_extend(const u8 *digest, bool violation)
+{
+	int rc;
+
+	if (!boot_cpu_has(X86_FEATURE_TDX_GUEST))
+		return;
+	if (violation)
+		memset(ima_operand, 0xff, SHA384_DIGEST_SIZE);
+	else
+		memcpy(ima_operand, digest, SHA384_DIGEST_SIZE);
+	do {
+		rc = tdx_mcall_extend_rtmr(2, ima_operand);
+		if (rc == -EBUSY)
+			cond_resched();
+	} while (rc == -EBUSY);
+	if (rc)
+		panic("IMA RTMR2 extend failed: %d", rc);
+}
+#endif
+
 #define TDX_MR_(r) .mr_value = (void *)TDREPORT_##r, TSM_MR_(r, SHA384)
 static struct tsm_measurement_register tdx_mrs[] = {
 	{ TDX_MR_(rtmr0) | TSM_MR_F_RTMR },
 	{ TDX_MR_(rtmr1) | TSM_MR_F_RTMR },
+#ifdef CONFIG_IMA_RTMR
+	/* IMA owns writes; a sysfs read must refresh from hardware. */
+	{ TDX_MR_(rtmr2) | TSM_MR_F_LIVE | TSM_MR_F_UNCACHED },
+#else
 	{ TDX_MR_(rtmr2) | TSM_MR_F_RTMR },
+#endif
 	{ TDX_MR_(rtmr3) | TSM_MR_F_RTMR },
 	{ TDX_MR_(mrtd) },
 	{ TDX_MR_(mrconfigid) | TSM_MR_F_NOHASH },
